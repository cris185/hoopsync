DATABASE_URL="postgresql://hoopsync:hoopsync@localhost:5433/hoopsync?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"
# Only reachable this way if you've exposed ocr-service's port to the
# host for local testing — inside docker-compose it's the internal
# hostname http://ocr-service:8000 instead (already set there).
OCR_SERVICE_URL="http://localhost:8000"
