DATABASE_URL="postgresql://hoopsync:hoopsync@localhost:5433/hoopsync?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"
# Only reachable this way if you've exposed ocr-service's port to the
# host for local testing — inside docker-compose it's the internal
# hostname http://ocr-service:8000 instead (already set there).
OCR_SERVICE_URL="http://localhost:8000"
# Same idea as OCR_SERVICE_URL above — "minio" is the docker-compose
# hostname; running the backend outside Docker needs localhost instead.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="hoopsync"
MINIO_SECRET_KEY="hoopsync123"
MINIO_BUCKET="hoopsync-media"
MINIO_PUBLIC_URL="http://localhost:9000"
