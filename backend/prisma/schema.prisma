generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users & Access
// ============================================================

enum UserRole {
  ADMIN
  ORGANIZER
  SCOREKEEPER
  SPECTATOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(SPECTATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournamentsCreated  Tournament[]
  matchAssignments    MatchOfficial[]
  scoreSheetsUploaded ScoreSheet[]
  recordedEvents      MatchEvent[]

  @@map("users")
}

// ============================================================
// Tournaments
// ============================================================

enum TournamentFormatType {
  ROUND_ROBIN
  HOME_AWAY
  SINGLE_ELIMINATION
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Tournament {
  id          String               @id @default(cuid())
  name        String
  description String?
  format      TournamentFormatType
  status      TournamentStatus     @default(DRAFT)
  // Playoffs are a bolt-on stage layered on top of the base format
  // (see PlayoffRound/PlayoffSeries below), not a format value itself.
  hasPlayoffs Boolean              @default(false)
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tournamentTeams TournamentTeam[]
  matches         Match[]
  standings       Standing[]
  playoffRounds   PlayoffRound[]

  @@map("tournaments")
}

// ============================================================
// Teams & Players
// ============================================================

model Team {
  id            String   @id @default(cuid())
  name          String
  logoUrl       String?
  coachName     String?
  coachPhotoUrl String?
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players          Player[]
  tournamentTeams  TournamentTeam[]
  homeMatches      Match[]                 @relation("HomeTeam")
  awayMatches      Match[]                 @relation("AwayTeam")
  standings        Standing[]
  playerMatchStats PlayerMatchStatistics[]
  teamMatchStats   TeamMatchStatistics[]
  matchEvents      MatchEvent[]
  playoffSeriesAsA PlayoffSeries[]         @relation("PlayoffTeamA")
  playoffSeriesAsB PlayoffSeries[]         @relation("PlayoffTeamB")
  playoffSeriesWon PlayoffSeries[]         @relation("PlayoffWinner")

  @@map("teams")
}

enum PlayerPosition {
  POINT_GUARD
  SHOOTING_GUARD
  SMALL_FORWARD
  POWER_FORWARD
  CENTER
}

model Player {
  id           String          @id @default(cuid())
  teamId       String
  team         Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  jerseyNumber Int
  position     PlayerPosition?
  photoUrl     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  matchEvents        MatchEvent[]
  // The other side of a SUBSTITUTION event (see MatchEvent.relatedPlayerId).
  substitutionEvents MatchEvent[]            @relation("SubstitutionRelatedPlayer")
  playerMatchStats   PlayerMatchStatistics[]
  ocrFieldMatches    OCRFieldResult[]

  // A jersey number is only unique within its own team, not globally.
  @@unique([teamId, jerseyNumber])
  @@map("players")
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seed         Int?
  registeredAt DateTime   @default(now())

  @@unique([tournamentId, teamId])
  @@map("tournament_teams")
}

// ============================================================
// Matches
// ============================================================

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  FINISHED
  CANCELLED
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeamId   String
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId   String
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  status       MatchStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  venue        String?
  // Round-robin / home-away round number. Null for playoff games,
  // which use playoffSeriesId + gameNumberInSeries instead.
  matchday     Int?

  playoffSeriesId    String?
  playoffSeries      PlayoffSeries? @relation(fields: [playoffSeriesId], references: [id], onDelete: SetNull)
  gameNumberInSeries Int?

  // Denormalized live/final score, derived from MatchEvent — kept here
  // for fast reads (scoreboard, schedule lists) without re-aggregating
  // events on every request.
  homeScore     Int  @default(0)
  awayScore     Int  @default(0)
  currentPeriod Int  @default(1)
  clockSeconds  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           MatchEvent[]
  officials        MatchOfficial[]
  playerStatistics PlayerMatchStatistics[]
  teamStatistics   TeamMatchStatistics[]
  scoreSheet       ScoreSheet?

  @@index([tournamentId, status])
  @@map("matches")
}

// A scorekeeper must be explicitly assigned to a match before they can
// record events for it (see spec: "Access assigned matches").
model MatchOfficial {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([matchId, userId])
  @@map("match_officials")
}

// ============================================================
// Match Events — the source of truth for everything below
// ============================================================

enum MatchEventType {
  FREE_THROW_MADE
  FREE_THROW_MISSED
  TWO_POINT_MADE
  TWO_POINT_MISSED
  THREE_POINT_MADE
  THREE_POINT_MISSED
  REBOUND_OFFENSIVE
  REBOUND_DEFENSIVE
  ASSIST
  STEAL
  BLOCK
  FOUL
  SUBSTITUTION
}

model MatchEvent {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  playerId String?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  // Only used for SUBSTITUTION: playerId = player coming in,
  // relatedPlayerId = player coming out.
  relatedPlayerId String?
  relatedPlayer   Player? @relation("SubstitutionRelatedPlayer", fields: [relatedPlayerId], references: [id], onDelete: SetNull)

  eventType    MatchEventType
  value        Int?
  period       Int
  clockSeconds Int

  // Corrections soft-delete rather than hard-delete: statistics and
  // standings are recalculated excluding deleted events, so a mistake
  // never destroys the audit trail (spec: "avoid permanently
  // corrupting statistics when a scorekeeper makes a mistake").
  isDeleted Boolean @default(false)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@map("match_events")
}

// ============================================================
// Statistics — derived caches, recalculated from MatchEvent
// whenever an event is added, edited or soft-deleted. Never
// written to directly by user input.
// ============================================================

model PlayerMatchStatistics {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  points            Int @default(0)
  reboundsOffensive Int @default(0)
  reboundsDefensive Int @default(0)
  assists           Int @default(0)
  steals            Int @default(0)
  blocks            Int @default(0)
  fouls             Int @default(0)

  freeThrowMade       Int @default(0)
  freeThrowAttempted  Int @default(0)
  twoPointMade        Int @default(0)
  twoPointAttempted   Int @default(0)
  threePointMade      Int @default(0)
  threePointAttempted Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@map("player_match_statistics")
}

model TeamMatchStatistics {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  points         Int @default(0)
  pointsConceded Int @default(0)
  fouls          Int @default(0)
  timeoutsUsed   Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId])
  @@map("team_match_statistics")
}

model Standing {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  gamesPlayed      Int @default(0)
  wins             Int @default(0)
  losses           Int @default(0)
  pointsFor        Int @default(0)
  pointsAgainst    Int @default(0)
  // Configurable points-per-result (e.g. 2 for a win, 1 for a loss),
  // kept separate from wins/losses so the rule can vary per tournament.
  tournamentPoints Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tournamentId, teamId])
  @@map("standings")
}

// ============================================================
// Playoffs
// ============================================================

enum PlayoffSeriesStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model PlayoffRound {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  // Best-of-N for every series in this round (1, 3, 5 or 7).
  bestOf       Int

  series PlayoffSeries[]

  @@map("playoff_rounds")
}

model PlayoffSeries {
  id             String              @id @default(cuid())
  playoffRoundId String
  playoffRound   PlayoffRound        @relation(fields: [playoffRoundId], references: [id], onDelete: Cascade)
  teamAId        String
  teamA          Team                @relation("PlayoffTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamBId        String
  teamB          Team                @relation("PlayoffTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  teamAWins      Int                 @default(0)
  teamBWins      Int                 @default(0)
  winnerTeamId   String?
  winnerTeam     Team?               @relation("PlayoffWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  status         PlayoffSeriesStatus @default(SCHEDULED)

  games Match[]

  @@map("playoff_series")
}

// ============================================================
// OCR Score Sheet Digitization
// ============================================================

enum ScoreSheetStatus {
  PENDING
  PROCESSING
  PROCESSED
  VALIDATED
  REJECTED
}

model ScoreSheet {
  id           String           @id @default(cuid())
  matchId      String           @unique
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  imageUrl     String
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  status       ScoreSheetStatus @default(PENDING)
  uploadedAt   DateTime         @default(now())

  processingResult OCRProcessingResult?

  @@map("score_sheets")
}

model OCRProcessingResult {
  id                String     @id @default(cuid())
  scoreSheetId      String     @unique
  scoreSheet        ScoreSheet @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  rawResponse       Json
  overallConfidence Float
  processedAt       DateTime   @default(now())

  fields OCRFieldResult[]

  @@map("ocr_processing_results")
}

// See spec section "Refined OCR Strategy": names are resolved against
// the team roster rather than trusted as free OCR text.
enum OCRResolutionMethod {
  EXACT_ROSTER_MATCH
  FUZZY_ROSTER_MATCH
  MARK_DETECTED
  NEEDS_REVIEW
}

model OCRFieldResult {
  id                    String              @id @default(cuid())
  ocrProcessingResultId String
  ocrProcessingResult   OCRProcessingResult @relation(fields: [ocrProcessingResultId], references: [id], onDelete: Cascade)
  fieldName             String
  rawText               String?
  confidence            Float
  resolutionMethod      OCRResolutionMethod
  matchedPlayerId       String?
  matchedPlayer         Player?             @relation(fields: [matchedPlayerId], references: [id], onDelete: SetNull)
  wasManuallyCorrected  Boolean             @default(false)

  @@map("ocr_field_results")
}
